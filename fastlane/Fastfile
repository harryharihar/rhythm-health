default_platform(:ios)

# Distributing via Firebase App Distribution (not TestFlight), so builds are
# always ad-hoc — testers install the .ipa directly and their device UDIDs
# must be registered in the provisioning profile match manages.
platform :ios do
  private_lane :build_and_sign do |options|
    app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_CONTENT'],
      is_key_content_base64: true
    )

    match(
      type: 'adhoc',
      app_identifier: options[:app_identifier],
      readonly: true
    )

    # expo prebuild --clean names the .xcworkspace/scheme after the app's
    # display name at generation time, which differs between "PocketVitals"
    # (Prod) and "PocketVitals Dev" — discover it instead of hardcoding it.
    # Anchored to this Fastfile's own location (repo_root/fastlane/Fastfile)
    # rather than a relative path, since other fastlane actions (e.g. match)
    # can change the process's working directory as a side effect.
    repo_root = File.expand_path('..', __dir__)
    workspace = Dir.glob(File.join(repo_root, 'ios', '*.xcworkspace')).first
    UI.user_error!("No .xcworkspace found under #{repo_root}/ios/") unless workspace
    scheme = File.basename(workspace, '.xcworkspace')

    build_app(
      workspace: workspace,
      scheme: scheme,
      export_method: 'ad-hoc',
      output_directory: File.join(repo_root, 'ios'),
      output_name: 'PocketVitals.ipa',
      # expo prebuild generates the project with Automatic signing but no
      # team set (it has no concept of Apple team IDs), so the archive step
      # fails with "requires a development team" even though match already
      # installed the right cert/profile locally — this just tells Xcode
      # which team to use them under.
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
      export_options: {
        provisioningProfiles: {
          options[:app_identifier] => "match AdHoc #{options[:app_identifier]}"
        }
      }
    )
  end

  desc 'Build and sign the Dev/UAT variant'
  lane :dev do
    build_and_sign(app_identifier: 'com.harryharihar.pocketvitals.dev')
  end

  desc 'Build and sign the Prod variant'
  lane :prod do
    build_and_sign(app_identifier: 'com.harryharihar.pocketvitals')
  end
end
