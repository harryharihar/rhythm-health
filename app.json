{
  "expo": {
    "name": "PocketVitals",
    "slug": "pocketvitals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harryharihar.pocketvitals"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080C0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.harryharihar.pocketvitals"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Allow PocketVitals to count your steps automatically."
        }
      ],
      "expo-sqlite",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "PocketVitals reads heart rate, exercise minutes, and sleep data from Health to show them on your dashboard. This data never leaves your device."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2FEFAA"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0C0F"
        }
      ]
    ]
  }
}
