{
  "expo": {
    "name": "Rhythm",
    "slug": "rhythm-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harryharihar.rhythmhealth"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080C0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.harryharihar.rhythmhealth"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Rhythm to count your steps automatically."
        }
      ],
      "expo-sqlite",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Rhythm reads heart rate, exercise minutes, and sleep data from Health to show them on your dashboard. This data never leaves your device."
        }
      ]
    ]
  }
}
